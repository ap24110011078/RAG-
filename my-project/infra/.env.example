# Application
ENVIRONMENT=development
DEBUG=true

# Backend API
APP_NAME=RAG Document Intelligence
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag_db

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT / Security (change in production!)
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
STORAGE_PATH=/app/storage

# LLM / Embeddings
GEMINI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api

# CORS (comma-separated origins for backend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OMNIROUTE API KEY
RAG_key = sk-a79a0524f2ea68aa-458fbf-7270ae28